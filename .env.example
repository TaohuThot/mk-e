# คัดลอกไฟล์นี้เป็น .env.local (ห้าม commit ไฟล์ .env จริง)

# Postgres: ใช้ connection string จาก Neon หรือ Supabase ต้องมี sslmode=require
# ตัวอย่าง Neon: postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://inv:inv@localhost:5432/inventory

# ใช้เซ็น session cookie สร้างด้วยคำสั่ง: openssl rand -base64 32
AUTH_SECRET=

# Object storage แบบ S3-compatible สำหรับเก็บรูปสินค้า
# ถ้าเว้นว่าง รูปจะถูกเก็บที่ public/uploads (ใช้ได้แค่ตอน dev)
#
# Cloudflare R2:
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_PUBLIC_URL=https://pub-xxxx.r2.dev  (หรือโดเมนของคุณที่ผูกกับ bucket)
# Supabase Storage:
#   S3_ENDPOINT=https://<project_ref>.storage.supabase.co/storage/v1/s3
#   S3_REGION=<region ของโปรเจกต์>
#   S3_PUBLIC_URL=https://<project_ref>.supabase.co/storage/v1/object/public/<bucket>
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
